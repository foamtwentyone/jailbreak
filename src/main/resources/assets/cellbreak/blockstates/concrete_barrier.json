{
 "multipart": [
  {
   "when": {
    "up": "true"
   },
   "apply": {
    "model": "cellbreak:block/concrete_barrier_post"
   }
  },
  {
   "when": {
    "north": "low"
   },
   "apply": {
    "model": "cellbreak:block/concrete_barrier_side",
    "y": 0,
    "uvlock": true
   }
  },
  {
   "when": {
    "north": "tall"
   },
   "apply": {
    "model": "cellbreak:block/concrete_barrier_side_tall",
    "y": 0,
    "uvlock": true
   }
  },
  {
   "when": {
    "east": "low"
   },
   "apply": {
    "model": "cellbreak:block/concrete_barrier_side",
    "y": 90,
    "uvlock": true
   }
  },
  {
   "when": {
    "east": "tall"
   },
   "apply": {
    "model": "cellbreak:block/concrete_barrier_side_tall",
    "y": 90,
    "uvlock": true
   }
  },
  {
   "when": {
    "south": "low"
   },
   "apply": {
    "model": "cellbreak:block/concrete_barrier_side",
    "y": 180,
    "uvlock": true
   }
  },
  {
   "when": {
    "south": "tall"
   },
   "apply": {
    "model": "cellbreak:block/concrete_barrier_side_tall",
    "y": 180,
    "uvlock": true
   }
  },
  {
   "when": {
    "west": "low"
   },
   "apply": {
    "model": "cellbreak:block/concrete_barrier_side",
    "y": 270,
    "uvlock": true
   }
  },
  {
   "when": {
    "west": "tall"
   },
   "apply": {
    "model": "cellbreak:block/concrete_barrier_side_tall",
    "y": 270,
    "uvlock": true
   }
  }
 ]
}