{
  "multipart": [
    {
      "apply": {
        "model": "cellbreak:block/chain_link_post_ends"
      }
    },
    {
      "when": {
        "north": "false",
        "east": "false",
        "south": "false",
        "west": "false"
      },
      "apply": {
        "model": "cellbreak:block/chain_link_post"
      }
    },
    {
      "when": {
        "north": "true",
        "east": "false",
        "south": "false",
        "west": "false"
      },
      "apply": {
        "model": "cellbreak:block/chain_link_cap"
      }
    },
    {
      "when": {
        "north": "false",
        "east": "true",
        "south": "false",
        "west": "false"
      },
      "apply": {
        "model": "cellbreak:block/chain_link_cap",
        "y": 90
      }
    },
    {
      "when": {
        "north": "false",
        "east": "false",
        "south": "true",
        "west": "false"
      },
      "apply": {
        "model": "cellbreak:block/chain_link_cap_alt"
      }
    },
    {
      "when": {
        "north": "false",
        "east": "false",
        "south": "false",
        "west": "true"
      },
      "apply": {
        "model": "cellbreak:block/chain_link_cap_alt",
        "y": 90
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "cellbreak:block/chain_link_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "cellbreak:block/chain_link_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "cellbreak:block/chain_link_side_alt"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "cellbreak:block/chain_link_side_alt",
        "y": 90
      }
    }
  ]
}